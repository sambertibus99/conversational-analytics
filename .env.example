# Conversational Analytics - Environment Variables
# ================================================
# Kopiere diese Datei nach .env und fülle die Werte aus

# === Anthropic API ===
# Mehrere Keys mit Komma trennen für Rate Limit Rotation
ANTHROPIC_API_KEYS=sk-ant-api03-KEY1...,sk-ant-api03-KEY2...,sk-ant-api03-KEY3...

# === ThingsBoard ===
THINGSBOARD_URL=http://localhost:8080
THINGSBOARD_USERNAME=tenant@thingsboard.org
THINGSBOARD_PASSWORD=tenant

# Device ID des KRC5 Roboters (findet man via ThingsBoard UI oder API)
KRC5_DEVICE_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
