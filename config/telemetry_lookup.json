      "description": "Soll-Achswinkel A1-A6 ($AXIS_ACT)"
    },
    "axis_position_measured": {
      "name": "Achspositionen (Ist/Gemessen)",
      "aliases": ["istposition", "gemessene position", "messwert", "tatsächliche position", "encoderposition", "ist-achswinkel"],
      "unit": "°",
      "keys": ["axis_meas_a1_deg", "axis_meas_a2_deg", "axis_meas_a3_deg", "axis_meas_a4_deg", "axis_meas_a5_deg", "axis_meas_a6_deg"],
