      "keys": ["torqmon_a1_pct", "torqmon_a2_pct", "torqmon_a3_pct", "torqmon_a4_pct", "torqmon_a5_pct", "torqmon_a6_pct"],
      "description": "Momentenüberwachung/Kollisionserkennung ($TORQMON)"
    },
    "velocity_tcp": {
      "name": "Bahngeschwindigkeit TCP",
      "aliases": ["geschwindigkeit", "speed", "tempo", "velocity", "tcp-geschwindigkeit", "bahngeschwindigkeit", "fahrgeschwindigkeit"],
      "unit": "m/s",
      "keys": ["vel_act_m_per_s"],
