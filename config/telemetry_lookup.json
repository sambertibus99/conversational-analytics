      "name": "Energieverbrauch",
      "aliases": ["energie", "verbrauch", "strom", "leistung", "kwh", "energiekosten", "stromverbrauch"],
      "unit": "kWh",
      "keys": ["energy_period_kwh"],
      "description": "Energieverbrauch letzte 60 Min ($ENERGY_PERIOD)"
    },
    "utilization": {
      "name": "Momentanbelastung",
      "aliases": ["auslastung", "belastung", "nutzung", "getriebebelastung"],
      "unit": "%",
      "keys": ["utilization_current", "utilization_moving_max"],
      "description": "Momentanbelastung aller Achsen ($UTILIZATION)"
    },
    "program_state": {
      "name": "Programmzustand",
      "aliases": ["status", "programm", "override", "zustand", "programmstatus"],
      "keys": ["pro_state", "override_pct"],
      "description": "Programmstatus + Override ($PRO_STATE, $OV_PRO)"
    }
